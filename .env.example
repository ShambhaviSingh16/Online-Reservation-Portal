# For Docker Compose only. Copy to .env and replace this password.
DB_PASSWORD=replace-with-a-long-random-development-password

# Free Render-compatible email delivery (Brevo HTTPS API).
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=your-private-brevo-api-key
# MAIL_FROM=your-verified-sender@example.com
# PUBLIC_BASE_URL=https://your-trackease-host.example

# Optional SMTP settings for local development or hosts that permit SMTP traffic.
# MAIL_PROVIDER=smtp
# PUBLIC_BASE_URL=https://your-trackease-host.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=TrackEase <verified-sender@your-domain.example>
