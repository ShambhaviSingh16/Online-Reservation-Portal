<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.trainticket.model.Journey,com.trainticket.model.Station,java.util.List" %><% List<Journey> journeys=(List<Journey>)request.getAttribute("journeys"); Station departure=(Station)request.getAttribute("departureStation"),arrival=(Station)request.getAttribute("arrivalStation"); if(journeys==null || departure==null || arrival==null){response.sendRedirect(request.getContextPath()+"/user/bookTicket.jsp");return;} journeys.sort(java.util.Comparator.comparing(Journey::getDepartureTime)); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Available journeys | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro"><span class="eyebrow">A good journey starts with a good choice</span><h1>Find your connection.</h1><p>Compare your options, then let us take care of your seat.</p></div><section class="search-summary" aria-label="Your search"><div class="route-summary"><div><small>From</small><strong><%= com.trainticket.util.Html.escape(departure.getStationName()) %> <span class="muted"><%= com.trainticket.util.Html.escape(departure.getStationCode()) %></span></strong></div><span class="route-arrow" aria-hidden="true">→</span><div><small>To</small><strong><%= com.trainticket.util.Html.escape(arrival.getStationName()) %> <span class="muted"><%= com.trainticket.util.Html.escape(arrival.getStationCode()) %></span></strong></div><div class="route-date"><small>Travel date</small><strong><%= com.trainticket.util.Html.escape(request.getAttribute("travelDate")) %></strong></div><a class="button secondary small" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Edit search</a></div></section><div class="results-layout"><aside class="results-aside"><span class="eyebrow">Before you book</span><h3>A seat, sorted.</h3><p>Seat and coach numbers are assigned automatically when you confirm.</p><hr><p>Full train? Opt into the waiting list. Your ticket shows your current position; a seat is not guaranteed.</p><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/tickets">Manage my tickets ↗</a></aside><section aria-label="Available journeys"><div class="results-toolbar"><p><strong><%= com.trainticket.util.Html.escape(journeys.size()) %> journeys</strong> match your search</p><label class="visually-hidden" for="journeySort">Sort journeys</label><select id="journeySort" class="form-select sort-select" data-sort-journeys><option value="departure">Earliest departure</option><option value="fare">Lowest fare</option><option value="duration">Shortest journey</option></select></div><div data-journey-list><% for(Journey journey:journeys) { %><article class="journey-card" data-departure="<%= com.trainticket.util.Html.escape(journey.getDepartureTime().getTime()) %>" data-fare="<%= com.trainticket.util.Html.escape(journey.getFare()) %>" data-duration="<%= com.trainticket.util.Html.escape(journey.getArrivalTime().getTime()-journey.getDepartureTime().getTime()) %>"><div class="journey-header"><span class="train-symbol"><i class="fas fa-train" aria-hidden="true"></i></span><div><h3><%= com.trainticket.util.Html.escape(journey.getTrain().getTrainName()) %></h3><span class="train-number">TRAIN <%= com.trainticket.util.Html.escape(journey.getTrain().getTrainNumber()) %></span></div><span class="badge">STANDARD CLASS</span></div><div class="route-timeline"><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(journey.getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(journey.getDepartureStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(journey.getDepartureStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(journey.getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div><div class="route-duration"><%= com.trainticket.util.Html.escape(java.time.Duration.between(journey.getDepartureTime().toLocalDateTime(),journey.getArrivalTime().toLocalDateTime()).toHours()) %>h <%= com.trainticket.util.Html.escape(java.time.Duration.between(journey.getDepartureTime().toLocalDateTime(),journey.getArrivalTime().toLocalDateTime()).toMinutesPart()) %>m<span class="rail-line" aria-hidden="true"></span>Direct journey</div><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(journey.getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(journey.getArrivalStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(journey.getArrivalStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(journey.getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div></div><div class="journey-bottom"><div class="fare-amount">₹<%= com.trainticket.util.Html.escape(String.format(java.util.Locale.ENGLISH,"%,.2f",journey.getFare())) %><small>per passenger</small></div><span class="seat-availability"><%= com.trainticket.util.Html.escape(journey.getAvailableSeats() > 0 ? journey.getAvailableSeats()+" seats available" : "Waiting list available") %></span><% if(journey.isAdvancedReservations()) { %><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/reservation.jsp?journeyId=<%= journey.getJourneyId() %>">Choose class &amp; seats →</a><% } else { %><button type="button" class="button" data-bs-toggle="modal" data-bs-target="#booking<%= com.trainticket.util.Html.escape(journey.getJourneyId()) %>"><%= com.trainticket.util.Html.escape(journey.getAvailableSeats() > 0 ? "Book now" : "View options") %> <span aria-hidden="true">→</span></button><% } %></div></article><% } %></div><% if(journeys.isEmpty()) { %><div class="empty-state"><span class="empty-icon"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></span><h3>No journeys on this route yet.</h3><p>Try another date or a different station to find a connection.</p><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Modify search →</a></div><% } %></section></div>
<% for(Journey journey:journeys) { %><div class="modal fade" id="booking<%= com.trainticket.util.Html.escape(journey.getJourneyId()) %>" tabindex="-1" aria-labelledby="bookingTitle<%= com.trainticket.util.Html.escape(journey.getJourneyId()) %>" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="bookingTitle<%= com.trainticket.util.Html.escape(journey.getJourneyId()) %>">One step closer.</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><form action="${esc:html(pageContext.request.contextPath)}/user/bookTicket" method="post"><input type="hidden" name="csrfToken" value="${esc:html(sessionScope.csrfToken)}"><input type="hidden" name="journeyId" value="<%= com.trainticket.util.Html.escape(journey.getJourneyId()) %>"><input type="hidden" name="bookingRequestId" value="<%= com.trainticket.util.Html.escape(java.util.UUID.randomUUID()) %>"><div class="modal-body"><span class="eyebrow">Review your journey</span><h3><%= com.trainticket.util.Html.escape(journey.getTrain().getTrainName()) %></h3><ul class="list-group list-group-flush mb-4"><li class="list-group-item"><strong>From</strong> · <%= com.trainticket.util.Html.escape(journey.getDepartureStation().getStationName()) %><br><%= com.trainticket.util.Html.escape(journey.getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %> at <%= com.trainticket.util.Html.escape(journey.getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></li><li class="list-group-item"><strong>To</strong> · <%= com.trainticket.util.Html.escape(journey.getArrivalStation().getStationName()) %><br><%= com.trainticket.util.Html.escape(journey.getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %> at <%= com.trainticket.util.Html.escape(journey.getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></li><li class="list-group-item d-flex justify-content-between"><strong>Fare per passenger</strong><strong>₹<%= com.trainticket.util.Html.escape(String.format(java.util.Locale.ENGLISH,"%,.2f",journey.getFare())) %></strong></li></ul><section class="group-passengers" data-group-passengers data-unit-fare="<%= journey.getFare() %>">
<div class="d-flex justify-content-between align-items-center mb-3"><label class="form-label mb-0" for="passengerCount<%= journey.getJourneyId() %>">Passengers</label>
<select class="form-select passenger-count" id="passengerCount<%= journey.getJourneyId() %>" data-passenger-count aria-label="Number of passengers"><option value="1">1 passenger</option><option value="2">2 passengers</option><option value="3">3 passengers</option><option value="4">4 passengers</option><option value="5">5 passengers</option><option value="6">6 passengers</option></select></div>
<p class="field-help">Book up to 6 passengers together. Each receives their own seat and ticket. Seats together are not guaranteed.</p>
<div data-passenger-fields><div class="field"><label class="form-label" for="passenger<%= journey.getJourneyId() %>-0">Passenger 1 · full name</label><input class="form-control" id="passenger<%= journey.getJourneyId() %>-0" name="passengerName" value="${esc:html(sessionScope.user.fullName)}" maxlength="100" required autocomplete="name"></div></div>
<div class="group-total"><span>Total recorded fare <small data-passenger-summary>1 passenger</small></span><strong data-group-total>₹<%= com.trainticket.util.Html.escape(String.format(java.util.Locale.ENGLISH,"%,.2f",journey.getFare())) %></strong></div></section><div class="allocation-note"><strong><i class="fas fa-chair" aria-hidden="true"></i> Automatic seat allocation</strong><p>We'll assign a seat and coach for each confirmed passenger. Without waiting-list consent, everyone must have a seat or no tickets are booked.</p><label><input type="checkbox" name="joinWaitingList" value="true">Allow any passengers without a seat to join the waiting list. Some passengers may be confirmed while others wait. Seats are not guaranteed for waitlisted passengers.</label></div><p class="field-help mt-3 mb-0">Demo reservation · No payment will be collected.</p></div><div class="modal-footer"><button type="button" class="button secondary" data-bs-dismiss="modal">Go back</button><button type="submit" class="button">Confirm booking →</button></div></form></div></div></div><% } %></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>
