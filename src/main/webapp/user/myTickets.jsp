<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,com.trainticket.model.Ticket" %><% List<Ticket> tickets=(List<Ticket>)request.getAttribute("tickets"); if(tickets==null){response.sendRedirect(request.getContextPath()+"/user/tickets");return;} tickets.sort(java.util.Comparator.comparing(Ticket::getBookingDate).reversed()); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My tickets | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro section-heading"><div><span class="eyebrow">Your journeys, all together</span><h1>My tickets.</h1><p>From the next departure to the places you've been.</p></div><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Book a journey ↗</a></div><% if(session.getAttribute("ticketMessage")!=null) { %><div class="alert alert-info" role="status"><%= com.trainticket.util.Html.escape(session.getAttribute("ticketMessage")) %></div><% session.removeAttribute("ticketMessage"); } %><div class="ticket-tabs" role="group" aria-label="Filter tickets by status"><button type="button" data-ticket-filter="all" aria-pressed="true" class="active">All tickets</button><button type="button" data-ticket-filter="CONFIRMED" aria-pressed="false" class="">Confirmed</button><button type="button" data-ticket-filter="RAC" aria-pressed="false">RAC / shared berth</button><button type="button" data-ticket-filter="WAITLISTED" aria-pressed="false" class="">Waitlisted</button><button type="button" data-ticket-filter="CANCELLED" aria-pressed="false" class="">Cancelled</button></div><% for(Ticket ticket:tickets) { %><article class="ticket-history-card" data-ticket-status="<%= com.trainticket.util.Html.escape(ticket.getStatus()) %>"><div class="ticket-history-main"><div class="ticket-history-top"><div><h3><%= com.trainticket.util.Html.escape(ticket.getJourney().getTrain().getTrainName()) %></h3><small>TRAIN <%= com.trainticket.util.Html.escape(ticket.getJourney().getTrain().getTrainNumber()) %> · TICKET #<%= com.trainticket.util.Html.escape(ticket.getTicketId()) %></small><% if(ticket.getPassengerName()!=null) { %><small>Passenger: <strong><%= com.trainticket.util.Html.escape(ticket.getPassengerName()) %></strong></small><% } %></div><span class="fare-amount">₹<%= com.trainticket.util.Html.escape(String.format(java.util.Locale.ENGLISH,"%,.2f",ticket.getJourney().getFare())) %></span></div><div class="route-timeline"><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div><div class="route-duration"><%= com.trainticket.util.Html.escape(java.time.Duration.between(ticket.getJourney().getDepartureTime().toLocalDateTime(),ticket.getJourney().getArrivalTime().toLocalDateTime()).toHours()) %>h <%= com.trainticket.util.Html.escape(java.time.Duration.between(ticket.getJourney().getDepartureTime().toLocalDateTime(),ticket.getJourney().getArrivalTime().toLocalDateTime()).toMinutesPart()) %>m<span class="rail-line" aria-hidden="true"></span>Direct journey</div><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div></div></div><div class="ticket-history-side"><% if(ticket.getBookingGroupId()!=null) { %><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/bookingConfirmation.jsp?bookingId=<%= com.trainticket.util.Html.escape(ticket.getBookingGroupId()) %>">Group booking ↗</a><% } %><span class="badge <%= com.trainticket.util.Html.escape("CONFIRMED".equals(ticket.getStatus()) ? "badge-confirmed" : "CANCELLED".equals(ticket.getStatus()) ? "badge-cancelled" : "badge-pending") %>"><%= com.trainticket.util.Html.escape(ticket.getStatus()) %></span><div class="seat-label"><% if("WAITLISTED".equals(ticket.getStatus())) { %>Waiting position <strong>#<%= com.trainticket.util.Html.escape(ticket.getWaitingPosition()) %></strong><% } else { %><%= "RAC".equals(ticket.getStatus())?"Shared berth":"Seat &amp; coach" %> <strong><%= com.trainticket.util.Html.escape(ticket.getSeatNumber()) %>-<%= com.trainticket.util.Html.escape(ticket.getCoachNumber()) %></strong><% } %></div><a class="btn btn-outline-primary" href="${esc:html(pageContext.request.contextPath)}/user/ticketConfirmation.jsp?ticketId=<%= com.trainticket.util.Html.escape(ticket.getTicketId()) %>">View ticket ↗</a><% if(!"CANCELLED".equals(ticket.getStatus()) && ticket.getJourney().getDepartureTime().after(new java.util.Date())) { %><form action="${esc:html(pageContext.request.contextPath)}/user/cancelTicket" method="post"><input type="hidden" name="csrfToken" value="${esc:html(sessionScope.csrfToken)}"><input type="hidden" name="ticketId" value="<%= com.trainticket.util.Html.escape(ticket.getTicketId()) %>"><button type="submit" class="btn btn-outline-danger">Cancel ticket</button></form><% } %></div></article><% } %><div class="empty-state" data-filter-empty hidden ><span class="empty-icon"><i class="fas fa-ticket" aria-hidden="true"></i></span><h3>No tickets in this view.</h3><p>Try another booking status to see your other journeys.</p></div><% if(tickets.isEmpty()) { %><div class="empty-state"><span class="empty-icon"><i class="fas fa-ticket" aria-hidden="true"></i></span><h3>Your first journey is waiting.</h3><p>You haven't booked any tickets yet. Find a connection and we'll save the details here.</p><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Find a train →</a></div><% } %></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>
