<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.trainticket.dao.TicketDAO,com.trainticket.model.Ticket,com.trainticket.model.User" %><%
    Ticket ticket = null;
    String ticketIdParam = request.getParameter("ticketId");
    if (ticketIdParam != null && !ticketIdParam.trim().isEmpty()) {
        try {
            int ticketId = Integer.parseInt(ticketIdParam);
            TicketDAO ticketDAO = new TicketDAO();
            ticket = ticketDAO.getTicketById(ticketId);
            User viewer = (User) session.getAttribute("user");
            if (ticket == null || viewer == null ||
                    (ticket.getUserId() != viewer.getUserId() && !"admin".equals(viewer.getRole()))) {
                response.setStatus(404);
                out.clear();
                out.print("Ticket not found.");
                return;
            }
        } catch (NumberFormatException e) {
            response.setStatus(400);
            out.clear();
            out.print("Invalid ticket reference.");
            return;
        }
    }
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Ticket confirmation | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro section-heading"><div><span class="eyebrow">The details that get you there</span><h1>Your journey, in one place.</h1></div><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/tickets">← My tickets</a></div><% if(ticket!=null) { %><article class="ticket-card"><header class="ticket-header"><div><h2><%= com.trainticket.util.Html.escape("RAC".equals(ticket.getStatus()) ? "Your shared berth is reserved." : "WAITLISTED".equals(ticket.getStatus()) ? "You’re on the waiting list." : "CANCELLED".equals(ticket.getStatus()) ? "Booking cancelled." : "You’re going places.") %></h2><p><%= com.trainticket.util.Html.escape("RAC".equals(ticket.getStatus()) ? "RAC accommodation: a shared berth, not an exclusive sleeping berth." : "CONFIRMED".equals(ticket.getStatus()) ? "Booking confirmed. Your seat is reserved." : "WAITLISTED".equals(ticket.getStatus()) ? "No seat assigned yet. Check back for your latest status." : "This ticket is no longer valid for travel.") %></p></div><div class="ticket-ref">TICKET REFERENCE<strong>#<%= com.trainticket.util.Html.escape(ticket.getTicketId()) %></strong></div></header><div class="ticket-body"><div class="ticket-train"><span class="train-symbol"><i class="fas fa-train" aria-hidden="true"></i></span><div><h3><%= com.trainticket.util.Html.escape(ticket.getJourney().getTrain().getTrainName()) %></h3><p>TRAIN <%= com.trainticket.util.Html.escape(ticket.getJourney().getTrain().getTrainNumber()) %> · <%= com.trainticket.util.Html.escape(ticket.getTravelClass()) %></p></div></div><div class="route-timeline"><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(ticket.getJourney().getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div><div class="route-duration"><%= com.trainticket.util.Html.escape(java.time.Duration.between(ticket.getJourney().getDepartureTime().toLocalDateTime(),ticket.getJourney().getArrivalTime().toLocalDateTime()).toHours()) %>h <%= com.trainticket.util.Html.escape(java.time.Duration.between(ticket.getJourney().getDepartureTime().toLocalDateTime(),ticket.getJourney().getArrivalTime().toLocalDateTime()).toMinutesPart()) %>m<span class="rail-line" aria-hidden="true"></span>Direct journey</div><div class="route-stop"><div class="route-time"><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm"))) %></div><strong><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalStation().getStationCode()) %> · <%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalStation().getStationName()) %></strong><small><%= com.trainticket.util.Html.escape(ticket.getJourney().getArrivalTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></small></div></div><div class="ticket-details"><div><small>Booking status</small><span class="badge <%= com.trainticket.util.Html.escape("CONFIRMED".equals(ticket.getStatus()) ? "badge-confirmed" : "CANCELLED".equals(ticket.getStatus()) ? "badge-cancelled" : "badge-pending") %>"><%= com.trainticket.util.Html.escape(ticket.getStatus()) %></span></div><div><small>Seat &amp; coach</small><strong><i class="fas fa-chair text-primary me-2" aria-hidden="true"></i> <% if("WAITLISTED".equals(ticket.getStatus())) { %>Waiting #<%= com.trainticket.util.Html.escape(ticket.getWaitingPosition()) %><% } else { %><%= com.trainticket.util.Html.escape(ticket.getSeatNumber()) %> (<%= com.trainticket.util.Html.escape(ticket.getCoachNumber()) %>)<% } %></strong></div><div><small>Recorded fare</small><strong>₹<%= com.trainticket.util.Html.escape(String.format(java.util.Locale.ENGLISH,"%,.2f",ticket.getJourney().getFare())) %></strong></div><div><small>Passenger</small><strong><%= com.trainticket.util.Html.escape(ticket.getPassengerName()!=null ? ticket.getPassengerName() : ticket.getUser().getFullName()) %></strong></div><div><small>Booked on</small><strong><%= com.trainticket.util.Html.escape(ticket.getBookingDate().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy"))) %></strong></div><div><small>Reservation type</small><strong>Demo booking</strong></div></div><% if(ticket.getBookingGroupId()!=null) { %><p class="mt-3 mb-0"><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/bookingConfirmation.jsp?bookingId=<%= com.trainticket.util.Html.escape(ticket.getBookingGroupId()) %>">View all passengers in this booking ↗</a></p><% } %><% if("RAC".equals(ticket.getStatus())) { %><p class="alert alert-info mt-3">RAC: this is a shared berth, not an exclusive sleeping berth. Your ticket may be promoted when a full berth becomes available.</p><% } %><p class="ticket-disclaimer">TrackEase portfolio demonstration · No payment collected. This is not an official railway travel document.</p><div class="ticket-actions"><a class="btn btn-primary" href="${esc:html(pageContext.request.contextPath)}/api/bookings/<%= ticket.getTicketId() %>/pdf">Download PDF</a><a class="btn btn-outline-primary" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Book another →</a><button type="button" onclick="window.print()" class="btn btn-primary"><i class="fas fa-print" aria-hidden="true"></i> Print ticket</button><a class="btn btn-outline-secondary" href="${esc:html(pageContext.request.contextPath)}/user/userDashboard.jsp">Dashboard</a></div></div></article><% } else { %><div class="empty-state"><h3>Ticket not found.</h3><p>Open My tickets to find your booking.</p><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/tickets">My tickets →</a></div><% } %></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>
