<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.trainticket.dao.StationDAO,com.trainticket.model.Station,java.util.List" %>
<% List<Station> stations=new StationDAO().getAllStations(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Find trains | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro"><span class="eyebrow">Make room for your next adventure</span><h1>Where are we headed?</h1><p>Find the right train. We'll take care of your seat.</p></div><div class="steps" aria-label="Booking steps"><span class="current"><b>1</b> Find a train</span><span><b>2</b> Confirm booking</span><span><b>3</b> Your ticket</span></div><% if(session.getAttribute("error")!=null) { %><div class="alert alert-danger" role="alert"><%= com.trainticket.util.Html.escape(session.getAttribute("error")) %></div><% session.removeAttribute("error"); } %><div class="search-layout"><section class="search-panel"><h2>Let's plan your journey.</h2><form action="${esc:html(pageContext.request.contextPath)}/user/searchJourney" method="post" data-journey-search><input type="hidden" name="csrfToken" value="${esc:html(sessionScope.csrfToken)}"><div class="station-fields"><div class="field"><label for="departureStation" class="form-label">From station</label><select class="form-select" id="departureStation" name="departureStation" required><option value="">Select a station</option><% for(Station station: stations) { %><option value="<%= com.trainticket.util.Html.escape(station.getStationId()) %>"><%= com.trainticket.util.Html.escape(station.getStationName()) %> (<%= com.trainticket.util.Html.escape(station.getStationCode()) %>)</option><% } %></select></div><button type="button" class="swap-button" data-swap-stations aria-label="Swap departure and destination">⇄</button><div class="field"><label for="arrivalStation" class="form-label">To station</label><select class="form-select" id="arrivalStation" name="arrivalStation" required><option value="">Select a station</option><% for(Station station: stations) { %><option value="<%= com.trainticket.util.Html.escape(station.getStationId()) %>"><%= com.trainticket.util.Html.escape(station.getStationName()) %> (<%= com.trainticket.util.Html.escape(station.getStationCode()) %>)</option><% } %></select></div></div><div class="field"><label for="travelDate" class="form-label">Travel date</label><input type="date" class="form-control" id="travelDate" name="travelDate" required><div class="date-quick"><button type="button" data-date-offset="0">Today</button><button type="button" data-date-offset="1">Tomorrow</button></div></div><div class="search-submit"><small><i class="fas fa-chair" aria-hidden="true"></i> Seat &amp; coach assigned at booking</small><button class="button" type="submit">Find trains <i class="fas fa-arrow-right" aria-hidden="true"></i></button></div></form></section><aside class="travel-aside"><img src="${esc:html(pageContext.request.contextPath)}/assets/images/rail-landscape.svg" alt="Scenic train illustration"><div><span class="eyebrow">Enjoy the journey</span><h3>Less planning.<br>More looking out.</h3><p>Compare fares and availability before you book. If seats fill up, choose to join the waiting list.</p></div></aside></div></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>