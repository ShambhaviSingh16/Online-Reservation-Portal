<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Routes, classes & seats | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body><jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro"><span class="eyebrow">TrackEase / Routes, classes & seats</span><h1>Routes, classes & seats</h1></div><div data-feature-message role="alert" hidden></div><section class="panel" data-advanced-search><h2>Find a connection between any two stops.</h2><form data-segment-search class="catalog-controls"><div><label for="segmentFrom" class="form-label">From station</label><select class="form-select" name="departureStation" id="segmentFrom" required></select></div><div><label for="segmentTo" class="form-label">To station</label><select class="form-select" name="arrivalStation" id="segmentTo" required></select></div><div><label for="segmentDate" class="form-label">Date</label><input class="form-control" type="date" name="travelDate" id="segmentDate" required></div><button class="button" type="submit">Find route segments</button></form><div data-segment-results class="mt-3"></div><p class="field-help">This search covers journeys with configured stops and classes. Use the standard search for older single-class journeys.</p></section><section class="panel mt-4" data-advanced-booking hidden><div class="section-heading"><div><span class="eyebrow">Choose your journey</span><h2>Make the seat yours.</h2></div><span data-plan-fare class="fare-amount"></span></div><div class="catalog-controls"><div><label for="planFrom" class="form-label">Board at</label><select class="form-select" id="planFrom" data-plan-from></select></div><div><label for="planTo" class="form-label">Get off at</label><select class="form-select" id="planTo" data-plan-to></select></div><div><label for="planClass" class="form-label">Class</label><select class="form-select" id="planClass" data-plan-class></select></div><button type="button" class="button secondary" data-refresh-seats>Refresh availability</button></div><p class="field-help mt-3">Green seats are available for this segment. Select seats for a two-minute hold, or leave selection empty for automatic allocation. RAC berths are reserved for sharing and cannot be selected as full berths.</p><div class="seat-legend"><span>□ Available</span><span>■ Occupied / held</span><span>RAC: shared berth</span></div><div data-seat-map class="seat-map"></div><div class="catalog-pagination"><button type="button" class="button secondary" data-hold-seats>Hold selected seats</button><span data-hold-status role="status"></span><button type="button" class="button secondary small" data-release-hold hidden>Release hold</button></div><form data-advanced-reserve><div class="group-passengers" data-group-passengers data-unit-fare="0"><div class="d-flex justify-content-between align-items-center mb-3"><label class="form-label" for="advancedCount">Passengers</label><select class="form-select passenger-count" id="advancedCount" data-passenger-count><option value="1">1 passenger</option><option value="2">2 passengers</option><option value="3">3 passengers</option><option value="4">4 passengers</option><option value="5">5 passengers</option><option value="6">6 passengers</option></select></div><div data-passenger-fields><div class="field"><label for="advancedName" class="form-label">Passenger 1 · full name</label><input class="form-control" name="passengerName" id="advancedName" required maxlength="100" value="${esc:html(sessionScope.user.fullName)}"></div></div><div class="group-total"><span>Recorded fare <small data-passenger-summary>1 passenger</small></span><strong data-group-total></strong></div></div><div class="field"><label for="berthPreference" class="form-label">Berth preference (best effort)</label><select id="berthPreference" class="form-select" name="preference"><option value="ANY">Any available berth</option><option>SEAT</option><option>LOWER</option><option>MIDDLE</option><option>UPPER</option><option>SIDE_LOWER</option><option>SIDE_UPPER</option></select></div><label class="d-block mb-3"><input type="checkbox" name="allowRac"> Allow RAC: a shared side-lower berth, not an exclusive sleeping berth.</label><label class="d-block mb-3"><input type="checkbox" name="joinWaitingList"> Allow waiting-list tickets if no full berth or permitted RAC place remains.</label><p class="field-help">Without waiting-list consent, everyone must receive a full seat or an explicitly permitted RAC place. Selected holds must match the passenger count. Seats together and berth preferences are not guaranteed.</p><button class="button" type="submit">Confirm passenger tickets →</button></form></section></main><jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>