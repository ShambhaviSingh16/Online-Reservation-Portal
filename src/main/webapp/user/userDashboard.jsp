<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.trainticket.model.User" %>
<% User user=(User)session.getAttribute("user"); if(user==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;}
java.util.List<com.trainticket.model.Ticket> upcoming=new com.trainticket.dao.TicketDAO().getTicketsByUser(user.getUserId()).stream().filter(t -> "CONFIRMED".equals(t.getStatus()) && t.getJourney().getDepartureTime().after(new java.util.Date())).sorted(java.util.Comparator.comparing(t -> t.getJourney().getDepartureTime())).limit(5).toList(); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your travel dashboard | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main class="shell" id="main-content"><section class="dashboard-hero"><div class="dashboard-copy"><span class="eyebrow">Your next chapter awaits</span><h1>Welcome back,<br><%= com.trainticket.util.Html.escape(user.getFullName()) %>.</h1><p>A familiar route or somewhere completely new? Let's get your next journey on track.</p><a class="button" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Find a train <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><img src="${esc:html(pageContext.request.contextPath)}/assets/images/rail-landscape.svg" alt="Train crossing a scenic green valley"></section><div class="dashboard-grid"><section><div class="section-heading"><div><span class="eyebrow">Something to look forward to</span><h2 style="font-size:26px">Upcoming journeys</h2></div><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/tickets">All tickets ↗</a></div><% if(upcoming.isEmpty()) { %><div class="empty-state"><span class="empty-icon"><i class="fas fa-route" aria-hidden="true"></i></span><h3>Your next adventure goes here.</h3><p>No upcoming confirmed journeys yet. Find a train and give yourself something to look forward to.</p><a class="button secondary" href="${esc:html(pageContext.request.contextPath)}/user/bookTicket.jsp">Explore journeys →</a></div><% } else { %><div class="panel"><% for(com.trainticket.model.Ticket t:upcoming) { %><article class="upcoming-item"><span class="eyebrow"><%= com.trainticket.util.Html.escape(t.getJourney().getDepartureTime().toLocalDateTime().format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy · HH:mm"))) %></span><h4><%= com.trainticket.util.Html.escape(t.getJourney().getTrain().getTrainName()) %></h4><p><%= com.trainticket.util.Html.escape(t.getJourney().getDepartureStation().getStationName()) %> → <%= com.trainticket.util.Html.escape(t.getJourney().getArrivalStation().getStationName()) %></p><a class="text-link" href="${esc:html(pageContext.request.contextPath)}/user/ticketConfirmation.jsp?ticketId=<%= com.trainticket.util.Html.escape(t.getTicketId()) %>">View ticket ↗</a></article><% } %></div><% } %><div class="info-banner"><strong>A little peace of mind.</strong> Find your assigned seat, waiting list status, and cancellation options in My tickets.</div></section><aside class="panel"><span class="eyebrow">Your passenger details</span><h3>Ready when you are.</h3><div class="profile-detail"><small>Full name</small><strong><%= com.trainticket.util.Html.escape(user.getFullName()) %></strong></div><div class="profile-detail"><small>Email</small><strong><%= com.trainticket.util.Html.escape(user.getEmail()) %></strong></div><div class="profile-detail"><small>Username</small><strong><%= com.trainticket.util.Html.escape(user.getUsername()) %></strong></div><div class="profile-detail"><small>Account</small><strong>Passenger</strong></div></aside></div></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>