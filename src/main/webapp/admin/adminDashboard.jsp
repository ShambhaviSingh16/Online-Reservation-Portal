<%@ page import="com.trainticket.model.User" %><% User user=(User)session.getAttribute("user"); if(user==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;} java.util.Map<String,Object> stats=new com.trainticket.dao.AnalyticsDAO().summary(); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Dashboard | TrackEase</title><jsp:include page="../WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="../navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro section-heading"><div><span class="eyebrow">TrackEase operations</span><h1>Admin Dashboard</h1><p>Welcome back, <%= com.trainticket.util.Html.escape(user.getFullName()) %>. Here's your railway at a glance.</p></div><a class="button" href="${esc:html(pageContext.request.contextPath)}/admin/journey">Manage journeys ↗</a></div><div class="admin-stats"><div class="panel"><small>Active trains</small><div class="stat-number"><%= com.trainticket.util.Html.escape(stats.get("trains")) %></div><p>Train records available for scheduling</p></div><div class="panel"><small>Upcoming journeys</small><div class="stat-number"><%= com.trainticket.util.Html.escape(stats.get("upcoming_journeys")) %></div><p>Scheduled future departures</p></div><div class="panel"><small>Today’s bookings</small><div class="stat-number"><%= com.trainticket.util.Html.escape(stats.get("bookings_today")) %></div><p>All booking statuses</p></div><div class="panel"><small>Confirmed booking value</small><div class="stat-number">₹<%= com.trainticket.util.Html.escape(stats.get("confirmed_booking_value")) %></div><p>Recorded fares; no payment collected</p></div></div><div class="section-heading"><div><span class="eyebrow">Your workspace</span><h2 style="font-size:27px">Keep every journey moving.</h2></div></div><div class="operation-grid"><a class="operation-link" href="${esc:html(pageContext.request.contextPath)}/admin/train"><i class="fas fa-train" aria-hidden="true"></i><h3>Trains</h3><p>Manage your fleet and seating capacity.</p><span class="text-link">Open workspace ↗</span></a><a class="operation-link" href="${esc:html(pageContext.request.contextPath)}/admin/station"><i class="fas fa-location-dot" aria-hidden="true"></i><h3>Stations</h3><p>Keep station and location details up to date.</p><span class="text-link">Open workspace ↗</span></a><a class="operation-link" href="${esc:html(pageContext.request.contextPath)}/admin/journey"><i class="fas fa-route" aria-hidden="true"></i><h3>Journeys</h3><p>Schedule departures, routes, and fares.</p><span class="text-link">Open workspace ↗</span></a><a class="operation-link" href="${esc:html(pageContext.request.contextPath)}/admin/tickets"><i class="fas fa-ticket" aria-hidden="true"></i><h3>Bookings</h3><p>Review tickets and passenger allocations.</p><span class="text-link">Open workspace ↗</span></a></div><div class="info-banner"><strong>Booking overview</strong> · <%= com.trainticket.util.Html.escape(stats.get("confirmed")) %> confirmed · <%= com.trainticket.util.Html.escape(stats.get("waiting")) %> on the waiting list. Figures are read from your current database.</div></main>
<jsp:include page="../WEB-INF/ui/footer.jsp" /></body></html>