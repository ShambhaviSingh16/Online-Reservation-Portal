<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recover your account | TrackEase</title><jsp:include page="WEB-INF/ui/head.jsp" /></head><body><jsp:include page="navbar.jsp" /><main id="main-content" class="shell"><div class="page-intro"><span class="eyebrow">TrackEase / Recover your account</span><h1>Recover your account</h1></div><div data-feature-message role="alert" hidden></div><section class="panel feature-narrow"><h2>Send a password-reset link.</h2><form data-request-reset><div class="field"><label class="form-label" for="resetUsername">Username</label><input class="form-control" id="resetUsername" name="username" required maxlength="100" autocomplete="username"></div><button class="button" type="submit">Email reset link</button></form><p class="field-help mt-3">Delivery requires a configured email service. Links expire in 30 minutes.</p><hr><h2>Or use a saved recovery code.</h2><p>Use a recovery code you previously saved from Account security. Email delivery is not required. If you have no code, contact the application administrator; this page cannot bypass account ownership.</p><form data-recover><div class="field"><label class="form-label" for="recoveryUsername">Username</label><input class="form-control" id="recoveryUsername" name="username" required maxlength="100" autocomplete="username"></div><div class="field"><label class="form-label" for="recoveryCode">Saved recovery code</label><input class="form-control" id="recoveryCode" name="recoveryCode" required maxlength="64" autocomplete="off" spellcheck="false"></div><div class="field"><label class="form-label" for="newPassword">New password</label><input class="form-control" type="password" id="newPassword" name="newPassword" required minlength="12" maxlength="128" autocomplete="new-password"></div><button class="button" type="submit">Reset password</button></form><p class="field-help mt-3">A successful reset signs out prior sessions and invalidates all old recovery codes.</p></section></main><jsp:include page="WEB-INF/ui/footer.jsp" /></body></html>