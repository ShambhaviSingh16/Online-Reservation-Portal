<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Reset password | TrackEase</title><jsp:include page="WEB-INF/ui/head.jsp" /></head><body><jsp:include page="navbar.jsp" /><main class="shell" id="main-content"><div class="page-intro"><span class="eyebrow">Account recovery</span><h1>Choose a new password.</h1></div><div data-feature-message role="alert" hidden></div><section class="panel feature-narrow"><form data-email-reset><div class="field"><label class="form-label" for="resetPassword">New password</label><input class="form-control" type="password" id="resetPassword" name="newPassword" minlength="12" maxlength="128" autocomplete="new-password" required></div><button class="button" type="submit">Reset password</button></form><p class="field-help mt-3">The link is single-use. A successful reset signs out prior sessions and invalidates other recovery links and saved recovery codes.</p><a href="${esc:html(pageContext.request.contextPath)}/recover.jsp" class="text-link">Request another reset link →</a></section></main><jsp:include page="WEB-INF/ui/footer.jsp" /></body></html>