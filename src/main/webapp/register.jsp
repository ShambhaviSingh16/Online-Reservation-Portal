<%@ taglib prefix="esc" uri="/WEB-INF/functions.tld" %>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Register | TrackEase</title><jsp:include page="WEB-INF/ui/head.jsp" /></head><body>
<jsp:include page="navbar.jsp" /><main id="main-content" class="auth-layout"><aside class="auth-story"><span class="eyebrow">Every great trip starts somewhere</span><h2>A new account.<br>A world of journeys.</h2><p>A quieter kind of booking experience. Your trains, your tickets, and the next place you want to be.</p><img src="${esc:html(pageContext.request.contextPath)}/assets/images/rail-landscape.svg" alt="Train travelling through a mountain landscape"></aside><section class="auth-form-wrap"><div class="auth-form"><span class="eyebrow">Join TrackEase</span><h1>Create your account</h1><p>One account to book, track, and manage your train journeys.</p><% if(request.getAttribute("error")!=null) { %><div class="alert alert-danger" role="alert">${esc:html(error)}</div><% } %><% if(request.getAttribute("success")!=null) { %><div class="alert alert-info" role="status">${esc:html(success)}</div><% } %><form action="${esc:html(pageContext.request.contextPath)}/register" method="post"><input type="hidden" name="csrfToken" value="${esc:html(sessionScope.csrfToken)}"><div class="field"><label for="fullName">Full name</label><input class="form-control" id="fullName" name="fullName" autocomplete="name" placeholder="Your full name" required></div><div class="field"><label for="email">Email address</label><input class="form-control" type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required></div><div class="field"><label for="username">Username</label><input class="form-control" id="username" name="username" autocomplete="username" placeholder="Enter your username" required></div><div class="field"><label for="password">Password</label><div class="password-field"><input class="form-control" type="password" id="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="password-help" placeholder="Create a strong password" required><button type="button" data-password-toggle="password" aria-pressed="false" aria-label="Show or hide password">Show</button></div><p class="field-help" id="password-help">Use 12–128 characters. A memorable passphrase works well.</p></div><button class="button w-100" type="submit">Create account <i class="fas fa-arrow-right" aria-hidden="true"></i></button></form><div class="auth-switch">Already have an account? <a href="${esc:html(pageContext.request.contextPath)}/login.jsp">Login</a></div><p class="auth-note"><i class="fas fa-shield-halved" aria-hidden="true"></i> Your account, your journeys. Passwords are securely protected.</p></div></section></main>
<jsp:include page="WEB-INF/ui/footer.jsp" /></body></html>